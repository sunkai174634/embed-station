# Set these at deployment time; no host-specific path or group ID is assumed.
# For MODEL_FORMAT=onnx, point MODEL_DIR at a directory with model.onnx plus
# tokenizer files (e.g. the hs-embed-1 ONNX export).
MODEL_DIR=/path/to/qwen3-embedding-0.6b-int8-ov
MODEL_ID=qwen3-embedding-0.6b-int8-ov
# openvino = OpenVINO IR export (default); onnx = ONNX encoder via OpenVINO.
MODEL_FORMAT=openvino
# Optional second model in the same container: an ONNX cross-encoder served at
# /v1/rerank (TEI-compatible). Point at a directory with model.onnx + tokenizer
# (e.g. the hs-rerank-1 ONNX export). Empty = reranking disabled.
RERANKER_MODEL_DIR=
RERANKER_MODEL_ID=hs-rerank-1-onnx
VIDEO_GID=REPLACE_WITH_HOST_VIDEO_GID
RENDER_GID=REPLACE_WITH_HOST_RENDER_GID

# --- Tunables (defaults are the recommended values) ---
# Request-level workers (tokenization/HTTP); GPU inference is serialized on N150.
INFER_JOBS=1
# Micro-batch size + collection window. At current traffic (one request per ~97s
# at peak) coalescing never triggers, so this behaves identically to batch=1;
# if load ever rises, requests within the window merge automatically for free
# throughput. Worst added latency for a lone request: the 20ms window.
BATCH_SIZE=4
# Micro-batch collection window in ms. 0 disables cross-request batching.
BATCH_WINDOW_MS=20
# Max input tokens per request (sum across the input array). Per-model limits
# live in each model directory's station_limits.json and take precedence over
# this default when the model ships one (e.g. Qwen3-INT8 declares 3584, the
# measured N150 iGPU hang threshold). Set this env only to override.
MAX_INPUT_TOKENS=3584
# Token budget for /v1/rerank (query + all candidate texts). Same precedence:
# the reranker's station_limits.json (max_total_tokens) wins when present.
RERANK_MAX_TOKENS=24000
# Max strings per request array (typical upstream batches send up to 100).
MAX_BATCH_ITEMS=100
# Overload guard: total queued + in-flight items across the service. New
# requests get 503 (with Retry-After) beyond this, so timed-out client work
# cannot pile up behind a slow GPU and starve fresh requests.
MAX_QUEUE_ITEMS=512
# Per-request inference timeout in seconds. Peak measured demand (NewAPI logs,
# busiest hour) averages 8.8 tok/s vs a 330 tok/s ceiling, so 3584-token worst
# cases are rare; 30s bounds them without cutting off legitimate load.
INFER_TIMEOUT_S=30
# Days of request/event history to keep. 0 = keep forever (manual cleanup).
TELEMETRY_RETENTION_DAYS=0
